# ===== RETIRED (contact form removed, Spec 1 Jul 2026) =====
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# CONTACT_TO_EMAIL="ahmedyhussain07@gmail.com"
# CONTACT_FROM_EMAIL="Ahmed Hussain <noreply@ahmedyhussain.com>"
# ============================================================

# Upstash Redis (guestbook, highscores, feature requests)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Admin key for DELETE /api/guestbook, DELETE /api/highscores and GET /api/feature-request
GUESTBOOK_ADMIN_KEY=

# Feature requests (desk Request app): emailed through Resend when both are set,
# always also kept in Redis. Without a verified domain, leave FROM unset: Resend's
# shared onboarding sender delivers only to the Resend account's own email.
RESEND_API_KEY=
FEATURE_REQUEST_TO_EMAIL=
# FEATURE_REQUEST_FROM_EMAIL="Room <requests@ahmedyhussain.com>"

# Optional: GitHub personal access token raises the unauthenticated API rate limit.
# The GitHub project page works without it (60 req/hr unauthenticated).
# Create one at https://github.com/settings/tokens (no scopes needed for public repos).
# GITHUB_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxx"

# Base URL — used for OG images and canonical URLs
# Default: https://ahmedyhussain.com
NEXT_PUBLIC_BASE_URL="https://ahmedyhussain.com"
